{
  "cli": {
    "version": ">= 16.6.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "GOOGLE_SERVICES_JSON": "secret:GOOGLE_SERVICES_JSON",
        "GOOGLE_SERVICE_INFO_PLIST": "secret:GOOGLE_SERVICE_INFO_PLIST",
        "FIREBASE_API_KEY": "secret:FIREBASE_API_KEY",
        "FIREBASE_PROJECT_ID": "secret:FIREBASE_PROJECT_ID",
        "FIREBASE_AUTH_DOMAIN": "secret:FIREBASE_AUTH_DOMAIN",
        "FIREBASE_STORAGE_BUCKET": "secret:FIREBASE_STORAGE_BUCKET",
        "FIREBASE_ANDROID_APP_ID": "secret:FIREBASE_ANDROID_APP_ID",
        "FIREBASE_IOS_APP_ID": "secret:FIREBASE_IOS_APP_ID",
        "ELEVENLABS_API_KEY": "secret:ELEVENLABS_API_KEY",
        "CLAUDE_API_KEY": "secret:CLAUDE_API_KEY",
        "APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "GOOGLE_SERVICES_JSON": "secret:GOOGLE_SERVICES_JSON",
        "GOOGLE_SERVICE_INFO_PLIST": "secret:GOOGLE_SERVICE_INFO_PLIST",
        "FIREBASE_API_KEY": "secret:FIREBASE_API_KEY",
        "FIREBASE_PROJECT_ID": "secret:FIREBASE_PROJECT_ID",
        "FIREBASE_AUTH_DOMAIN": "secret:FIREBASE_AUTH_DOMAIN",
        "FIREBASE_STORAGE_BUCKET": "secret:FIREBASE_STORAGE_BUCKET",
        "FIREBASE_ANDROID_APP_ID": "secret:FIREBASE_ANDROID_APP_ID",
        "FIREBASE_IOS_APP_ID": "secret:FIREBASE_IOS_APP_ID",
        "ELEVENLABS_API_KEY": "secret:ELEVENLABS_API_KEY",
        "CLAUDE_API_KEY": "secret:CLAUDE_API_KEY",
        "APP_ENV": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "GOOGLE_SERVICES_JSON": "secret:GOOGLE_SERVICES_JSON",
        "GOOGLE_SERVICE_INFO_PLIST": "secret:GOOGLE_SERVICE_INFO_PLIST",
        "FIREBASE_API_KEY": "secret:FIREBASE_API_KEY",
        "FIREBASE_PROJECT_ID": "secret:FIREBASE_PROJECT_ID",
        "FIREBASE_AUTH_DOMAIN": "secret:FIREBASE_AUTH_DOMAIN",
        "FIREBASE_STORAGE_BUCKET": "secret:FIREBASE_STORAGE_BUCKET",
        "FIREBASE_ANDROID_APP_ID": "secret:FIREBASE_ANDROID_APP_ID",
        "FIREBASE_IOS_APP_ID": "secret:FIREBASE_IOS_APP_ID",
        "ELEVENLABS_API_KEY": "secret:ELEVENLABS_API_KEY",
        "CLAUDE_API_KEY": "secret:CLAUDE_API_KEY",
        "APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
